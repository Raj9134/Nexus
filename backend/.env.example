# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/NEXUS

# Auth
# Use a long random value. Every access and refresh token is signed with it.
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin, used for CORS and for the links inside outgoing email.
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Outgoing email (optional)
#
# With no SMTP settings the server logs each message and returns the token in the
# API response outside production, so local development and tests work with no
# mail provider. The boot log states which mode is active.
#
# SMTP_SECURE=true is for implicit TLS (port 465). Leave it unset for STARTTLS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=your-smtp-password
# MAIL_FROM=NEXUS <no-reply@yourdomain.com>
# MAIL_FROM_NAME=NEXUS

# --- Resend (recommended: one API key, 100 emails/day free) -------------
#
# 1. resend.com -> sign up -> API Keys -> Create API Key. Copy the re_... key.
# 2. Put it in SMTP_PASSWORD below. The username is the literal word "resend".
# 3. MAIL_FROM must be an address you have verified. Until you add a domain,
#    use the onboarding address, which can only send to your own email:
#      MAIL_FROM=NEXUS <onboarding@resend.dev>
#    To send to anyone else, add a domain in Resend and update MAIL_FROM.
#
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASSWORD=re_YOUR_API_KEY
# MAIL_FROM=NEXUS <onboarding@resend.dev>
# MAIL_FROM_NAME=NEXUS
