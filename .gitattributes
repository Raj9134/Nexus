# Normalize line endings in the repository so Windows checkouts and Linux
# deploys do not produce whole-file diffs.
* text=auto eol=lf

# Windows-native scripts must keep CRLF to remain executable.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp3 binary
*.wav binary
*.m4a binary
*.ogg binary
*.mp4 binary
*.webm binary
*.pdf binary
*.woff binary
*.woff2 binary
