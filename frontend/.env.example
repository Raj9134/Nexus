# Backend base URL. The frontend appends /api-less paths (e.g. /auth/login) to this.
# Defaults to http://localhost:5000/api when unset.
VITE_API_URL=http://localhost:5000/api

# Socket.IO origin for realtime updates. Optional: when unset it is derived from
# VITE_API_URL by dropping the trailing /api, so it defaults to http://localhost:5000.
# VITE_SOCKET_URL=http://localhost:5000
